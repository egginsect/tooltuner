# MCP Flywheel TS sample configuration. Copy to .env and adjust. NEVER commit real values.
# Secrets are read from the process environment or a credential helper; this file
# lists variable names and safe defaults only.

# --- HTTP listener (critical) ---
PORT=8787
HOST=127.0.0.1

# --- FalkorDB (critical): the single persistent shared state store ---
# Start locally with: docker compose up -d falkordb
FALKORDB_URL=redis://127.0.0.1:6379
FALKORDB_GRAPH=flywheel
# Optional ACL credentials. Leave empty for the local docker-compose instance.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# --- Public origin and OAuth (optional until the OAuth gate, TOO-77; reported as not_configured) ---
# Fixed public HTTPS origin served by the tunnel (for example an ngrok dev domain).
FLYWHEEL_PUBLIC_ORIGIN=
# Authorization server issuer, MCP resource URL, and allowed client redirect URIs (comma separated).
OAUTH_ISSUER=
OAUTH_RESOURCE=
OAUTH_ALLOWED_REDIRECT_URIS=
# Reference to the token signing key (a file path or credential-helper name); never the key itself.
OAUTH_SIGNING_KEY_REF=

# --- Registry / fixtures (optional) ---
# Path to a JSON file registering the baseline fixture applications.
FIXTURE_REGISTRY_PATH=

# --- Runner and Vercel (optional; trusted manager process only, never forwarded to coding jobs) ---
RUNNER_CONFIG_PATH=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Secret: set only in the manager's environment. Only its presence is ever reported.
VERCEL_TOKEN=

# --- Logging ---
LOG_LEVEL=info
