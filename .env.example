# MCP Flywheel TS sample configuration. Copy to .env and adjust. NEVER commit real values.
# Secrets are read from the process environment or a credential helper; this file
# lists variable names and safe defaults only.

# --- HTTP listener (critical) ---
PORT=8787
HOST=127.0.0.1

# --- FalkorDB (critical): the single persistent shared state store ---
# Start locally with: docker compose up -d falkordb
FALKORDB_URL=redis://127.0.0.1:6379
FALKORDB_GRAPH=flywheel
# Optional ACL credentials. Leave empty for the local docker-compose instance.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# --- Public origin and OAuth (required for protected MCP connections) ---
# Fixed public HTTPS origin served by the tunnel (for example an ngrok dev domain).
FLYWHEEL_PUBLIC_ORIGIN=
# Optional consistency checks; defaults are the public origin and <public origin>/mcp.
# The built-in SDK authorization server registers public PKCE clients dynamically.
OAUTH_ISSUER=
OAUTH_RESOURCE=
# Opaque codes and tokens are hashed in FalkorDB; no signing key is used.
# Single owner of this Flywheel; grants and records are scoped to it.
FLYWHEEL_OWNER_ID=owner
# Owner consent secret typed on the OAuth consent page (>= 16 chars). Never commit a real value.
FLYWHEEL_OWNER_SECRET=

# --- Registry / fixtures (optional) ---
# Path to a JSON file registering the baseline fixture applications.
FIXTURE_REGISTRY_PATH=

# --- Runner and Vercel (optional; trusted manager process only, never forwarded to coding jobs) ---
RUNNER_CONFIG_PATH=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Secret: set only in the manager's environment. Only its presence is ever reported.
VERCEL_TOKEN=

# --- Logging ---
LOG_LEVEL=info

# --- Optional encrypted upstream credential custody (trusted process only) ---
# PostgreSQL URL with no query parameters; TLS defaults on. Never print or forward this value.
FLYWHEEL_CREDENTIAL_POSTGRES_URL=
# JSON object mapping key version to a base64-encoded 32-byte key, injected externally.
# Keep historical keys available while their rows exist. Never commit real keys.
FLYWHEEL_CREDENTIAL_KEYS=
