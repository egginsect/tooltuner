{
  "name": "tooltuner",
  "version": "0.1.0",
  "private": true,
  "description": "ToolTuner: graph-backed gateway and improvement loop for MCP applications (Graph Hacks demo).",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "owner": "tsx src/cli/owner.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "demo:local": "bash scripts/demo-local.sh",
    "test:credentials": "vitest run --config vitest.credentials.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "falkordb": "^6.8.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
