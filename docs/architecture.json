  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Clients authorize with the gateway OAuth server and owner consent.",
        "Grant checks apply to discovery and dispatch. Dispatch resolves an immutable version, durably admits the call, then invokes the selected upstream tool.",
        "Incomplete durable completion is reported as unknown, never assumed successful."
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence and custody",
      "items": [
        "FalkorDB stores authorization, registry, evidence, feedback, packet, job and experiment state.",
        "Optional PostgreSQL stores encrypted upstream OAuth credentials; keys remain outside the database.",
        "Credential mediation binds use to the intended upstream target.",
        "Transaction-pooler refresh support is implemented and tested in the review PR stack, not merged main: durable versioned claims and compare-and-swap writes; unknown outcomes remain fenced. Live rollout is separate."
      ]
    },
    {
      "dot": "amber",
      "title": "Runtime boundary",
      "items": [
        "Hosted mode serves requests only: it disables local coding jobs, experiments, deployment managers and fixture seeding.",
        "Local runner and preview/experiment paths require explicit trusted configuration. They are implementation capabilities, not verified live deployment claims.",
        "The coding subprocess receives an allowlisted environment, not owner, database or deployment credentials."
      ]
    },
    {
      "dot": "rose",
      "title": "Owner decisions and scope",
      "items": [
        "Only the owner CLI records merge decisions and changes stable activation or rollback. Recommendations do not activate versions.",
        "Current owner authentication uses the gateway owner-secret flow. Supabase Auth is planned and is not shown as implemented.",
        "This sanitized overview omits private endpoints, identifiers, commit hashes and source hyperlinks."
      ]
    }
  ],
  "boundaries": [
    {
      "kind": "security-group",
